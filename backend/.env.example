DATABASE_URL="file:./dev.db"
PORT=3001

# Troque por um valor aleatório em produção, ex.: `openssl rand -hex 32`
JWT_SECRET="troque-este-valor-antes-de-ir-para-producao"

# Quantidade de boxes que atendem simultaneamente no mesmo horário (agenda).
LIMITE_BOXES_POR_HORARIO=3

# Notificação ao cliente quando a OS fica pronta (PB14). "simulado" (padrão)
# só loga a mensagem e grava no banco — não precisa de nenhuma credencial
# abaixo. Troque para "real" para mandar e-mail de verdade (Nodemailer/SMTP)
# e WhatsApp via webhook HTTP.
PROVEDOR_NOTIFICACAO=simulado

# Só usados quando PROVEDOR_NOTIFICACAO=real:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Overdrive <oficina@overdrive.com>"

# API de WhatsApp (qualquer webhook que aceite POST {to, message}).
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
